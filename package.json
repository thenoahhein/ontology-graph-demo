{
  "name": "ontology-graph-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Living Vendor Graph: an Agentstead-powered agent that maintains a temporal context graph in Zep",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/vendor/server.js",
    "dev": "tsx watch src/vendor/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "observe": "node dist/orchestrator/cli.js observe",
    "flip": "node dist/orchestrator/cli.js flip",
    "diff": "node dist/orchestrator/cli.js diff",
    "demo": "node dist/orchestrator/cli.js demo"
  },
  "dependencies": {
    "@getzep/zep-cloud": "3.26.0",
    "express": "4.21.2"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.10.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
